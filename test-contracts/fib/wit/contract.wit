package root:component;

world root {
  include kontor:built-in/built-in;
  use kontor:built-in/foreign.{contract-address};
  use kontor:built-in/context.{fall-context, view-context, proc-context, signer, contract};
  use kontor:built-in/error.{error};

  export init: func(ctx: borrow<proc-context>) -> contract;

  export fib: func(ctx: borrow<proc-context>, arith-address: contract-address, n: u64) -> u64;

  export fib-of-sub: func(ctx: borrow<proc-context>, arith-address: contract-address, x: string, y: string) -> result<u64, error>;

  export set-variant: func(ctx: borrow<proc-context>, kind: u64, count: u64, fail: bool);
  export variant-state: func(ctx: borrow<view-context>) -> list<u64>;
  export mutate-variant: func(ctx: borrow<proc-context>, key: u64);

  export clear-variant: func(ctx: borrow<proc-context>);
  export set-nested-variant: func(ctx: borrow<proc-context>, kind: u64, value: u64);
  export nested-variant-state: func(ctx: borrow<view-context>) -> list<u64>;

  export cached-values: func(ctx: borrow<view-context>) -> list<u64>;
}
