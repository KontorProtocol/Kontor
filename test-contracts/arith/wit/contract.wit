package root:component;

world root {
  include kontor:built-in/built-in;
  use kontor:built-in/foreign.{contract-address};
  use kontor:built-in/context.{view-context, proc-context, contract};
  use kontor:built-in/error.{error};

  record operand {
    y: u64,
  }

  variant op {
    id,
    sum(operand),
    mul(operand),
    div(operand),
  }

  record arith-return {
    value: u64
  }

  export init: async func(ctx: borrow<proc-context>) -> contract;

  export eval: async func(ctx: borrow<proc-context>, x: u64, op: op) -> arith-return;

  export last-op: async func(ctx: borrow<view-context>) -> option<op>;

  export put-numbers: async func(ctx: borrow<proc-context>, key: u64, integer: string, decimal: string);
  export change-integer: async func(ctx: borrow<proc-context>, key: u64, integer: string);
  export remove-numbers: async func(ctx: borrow<proc-context>, key: u64);
  export stored-numbers: async func(ctx: borrow<view-context>, key: u64) -> option<list<string>>;
  export optional-integer: async func(ctx: borrow<view-context>) -> option<string>;
  export number-keys: async func(ctx: borrow<view-context>) -> list<u64>;
  export number-index: async func(ctx: borrow<view-context>, integer: string) -> list<string>;

  export checked-sub: async func(ctx: borrow<view-context>, x: string, y: string) -> result<u64, error>;

  export mul-add-div-rem: async func(ctx: borrow<view-context>, a: string, b: string, carry: string, divisor: string) -> result<list<string>, error>;

  export integer-ops: async func(ctx: borrow<view-context>, a: string, b: string) -> result<list<string>, error>;
  export decimal-units: async func(ctx: borrow<view-context>, value: string) -> list<string>;

  export fib: async func(ctx: borrow<proc-context>, contract-address: contract-address, n: u64) -> u64;
}
