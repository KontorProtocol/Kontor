+fn namespaced_bindings(bindings: &str, namespace: &Namespace) -> String {
+    let symbols: BTreeSet<&str> =
+        include_str!("kontor-symbols.txt").lines().collect();
+    let mut output = String::new();
+    for line in bindings.lines() {
+        let declaration = line.trim_start();
+        let symbol = declaration
+            .strip_prefix("pub fn ")
+            .or_else(|| declaration.strip_prefix("pub static mut "))
+            .or_else(|| declaration.strip_prefix("pub static "));
+        if let Some(symbol) = symbol {
+            let end = symbol
+                .find(|c: char| !c.is_ascii_alphanumeric() && c != '_')
+                .unwrap();
+            let symbol = &symbol[..end];
+            assert!(
+                symbols.contains(symbol),
+                "unlisted blst FFI symbol: {}", symbol
+            );
+            output.push_str(&format!(
+                "    #[link_name = \"{}\"]\n",
+                namespace.symbol(symbol)
+            ));
+        }
+        output.push_str(line);
+        output.push('\n');
+    }
+    output
+}
