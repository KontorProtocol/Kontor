{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S2 paired resource qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_sha256", "cell", "source_sha", "lockfile_sha256",
    "binary_path", "binary_sha256", "compiler", "build_closure", "target", "host", "configurations", "memory_profiles"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "cell": {"enum": ["Linux-X64/dev", "Linux-X64/release", "Linux-ARM64/dev", "Linux-ARM64/release", "macOS-ARM64/dev", "macOS-ARM64/release"]},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lockfile_sha256": {"$ref": "#/$defs/sha256"},
    "binary_path": {"type": "string", "minLength": 1},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "compiler": {"type": "object", "required": ["rustc_verbose", "stack_probing_configuration"], "additionalProperties": false,
      "properties": {"rustc_verbose": {"type": "string", "minLength": 1}, "stack_probing_configuration": {"type": "string", "minLength": 1}}},
    "build_closure": {"type": "object", "required": ["profile", "target_triple", "cargo_features", "rustflags", "cargo_command", "cargo_cwd", "wasmtime_features", "wasmtime_feature_logs", "cargo_metadata_sha256", "compile_env_sha256", "build_log_sha256", "build_log", "cargo_metadata_log", "compile_env_log", "rustc_log", "binary_artifact"], "additionalProperties": false,
      "properties": {"profile": {"enum": ["dev", "release"]}, "target_triple": {"type": "string", "minLength": 1},
        "cargo_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cargo_cwd": {"type": "string", "minLength": 1},
        "cargo_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rustflags": {"type": "array", "items": {"type": "string"}},
        "wasmtime_features": {"type": "object", "required": ["production", "qualification"], "additionalProperties": false,
          "properties": {"production": {"$ref": "#/$defs/feature_list"},
            "qualification": {"$ref": "#/$defs/feature_list"}}},
        "wasmtime_feature_logs": {"type": "object", "required": ["production", "qualification"], "additionalProperties": false,
          "properties": {"production": {"$ref": "#/$defs/raw_log"},
            "qualification": {"$ref": "#/$defs/raw_log"}}},
        "cargo_metadata_sha256": {"$ref": "#/$defs/sha256"}, "compile_env_sha256": {"$ref": "#/$defs/sha256"},
        "build_log_sha256": {"$ref": "#/$defs/sha256"}, "build_log": {"$ref": "#/$defs/raw_log"},
        "cargo_metadata_log": {"$ref": "#/$defs/raw_log"}, "compile_env_log": {"$ref": "#/$defs/raw_log"},
        "rustc_log": {"$ref": "#/$defs/raw_log"}, "binary_artifact": {"$ref": "#/$defs/raw_log"}}},
    "target": {"type": "string", "minLength": 1},
    "host": {"type": "object", "required": ["os", "architecture", "cpu_count", "memory_bytes", "storage", "resource_enforcement"], "additionalProperties": false,
      "properties": {"os": {"type": "string"}, "architecture": {"type": "string"}, "cpu_count": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1}, "storage": {"type": "string"}, "resource_enforcement": {"type": "string"}}},
    "configurations": {"type": "object", "required": ["production", "reduced"], "additionalProperties": false,
      "properties": {"production": {"$ref": "#/$defs/configuration"}, "reduced": {"$ref": "#/$defs/configuration"}}},
    "memory_profiles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/memory_profile"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "raw_log": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "process": {"type": "object", "required": ["pid", "command", "started_unix_ns", "ended_unix_ns", "exit_code", "signal", "timed_out", "complete", "test_harness_passed"], "additionalProperties": false,
      "properties": {"pid": {"type": "integer", "minimum": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "started_unix_ns": {"type": "integer", "minimum": 1}, "ended_unix_ns": {"type": "integer", "minimum": 1},
        "exit_code": {"type": "integer"}, "signal": {"type": ["integer", "null"]}, "timed_out": {"type": "boolean"},
        "complete": {"type": "boolean"}, "test_harness_passed": {"type": "boolean"}}},
    "engine": {"type": "object", "required": ["wasmtime_revision", "target", "pulley_stack_bytes", "fiber_requested_bytes", "fiber_effective_writable_bytes", "page_size_bytes", "guard_bytes", "allocator", "sanitizer_mode"], "additionalProperties": false,
      "properties": {"wasmtime_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "target": {"type": "string"},
        "pulley_stack_bytes": {"type": "integer", "minimum": 1}, "fiber_requested_bytes": {"type": "integer", "minimum": 1},
        "fiber_effective_writable_bytes": {"type": "integer", "minimum": 1}, "page_size_bytes": {"type": "integer", "minimum": 1},
        "guard_bytes": {"type": "integer", "minimum": 1}, "allocator": {"type": "string"}, "sanitizer_mode": {"type": "string"}}},
    "thread": {"type": "object", "required": ["thread_category", "thread_id", "process_id", "os_thread_id", "identity_api", "page_size_bytes", "requested_bytes", "mapped_bytes", "guard_bytes", "guard_start", "guard_end", "guard_verification", "usable_bytes", "mapped_start", "mapped_end", "usable_start", "usable_end", "measurement_api", "guard_treatment", "guard_verified"], "additionalProperties": false,
      "properties": {"thread_category": {"enum": ["tokio_worker", "blocking_pool", "block_on_caller"]}, "thread_id": {"type": "string"},
        "process_id": {"type": "integer", "minimum": 1}, "os_thread_id": {"type": "integer", "minimum": 1},
        "identity_api": {"enum": ["linux_gettid", "macos_pthread_threadid_np"]},
        "page_size_bytes": {"type": "integer", "minimum": 1},
        "requested_bytes": {"type": ["integer", "null"], "minimum": 0}, "mapped_bytes": {"type": "integer", "minimum": 1},
        "guard_bytes": {"type": "integer", "minimum": 0}, "usable_bytes": {"type": "integer", "minimum": 1},
        "guard_start": {"type": "integer", "minimum": 0}, "guard_end": {"type": "integer", "minimum": 0},
        "guard_verification": {"enum": ["linux_maps_prot_none", "linux_proc_self_mem_eio", "macos_mach_vm_region_prot_none", "pthread_reports_none"]},
        "mapped_start": {"type": "integer", "minimum": 0}, "mapped_end": {"type": "integer", "minimum": 1},
        "usable_start": {"type": "integer", "minimum": 0}, "usable_end": {"type": "integer", "minimum": 1},
        "measurement_api": {"type": "string", "minLength": 1}, "guard_treatment": {"type": "string", "minLength": 1},
        "guard_verified": {"const": true}}},
    "runtime": {"type": "object", "required": ["flavor", "worker_count", "worker_requested_bytes", "thread_observations", "blocking_pool_observed", "block_on_caller_observed"], "additionalProperties": false,
      "properties": {"flavor": {"const": "multi_thread"}, "worker_count": {"type": "integer", "minimum": 2},
        "worker_requested_bytes": {"type": ["integer", "null"], "minimum": 1},
        "thread_observations": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/thread"}},
        "blocking_pool_observed": {"type": "boolean"}, "block_on_caller_observed": {"type": "boolean"}}},
    "fuel": {"type": "object", "required": ["user", "system", "deposit"], "additionalProperties": false,
      "properties": {"user": {"type": "integer", "minimum": 0}, "system": {"type": "integer", "minimum": 0},
        "deposit": {"type": "integer", "minimum": 0}}},
    "counts": {"type": "object", "required": ["before", "during", "after"], "additionalProperties": false,
      "properties": {"before": {"type": "integer", "minimum": 0}, "during": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0}}},
    "receipt": {"type": "object", "required": ["contract_id", "status", "gas", "value"], "additionalProperties": false,
      "properties": {"contract_id": {"type": "integer", "minimum": 0}, "status": {"type": "string"},
        "gas": {"type": "integer", "minimum": 0}, "value": {"type": ["string", "null"]}}},
    "state": {"type": "object", "required": ["before_sha256", "after_sha256", "marker", "balances_sha256"], "additionalProperties": false,
      "properties": {"before_sha256": {"$ref": "#/$defs/sha256"}, "after_sha256": {"$ref": "#/$defs/sha256"},
        "marker": {"type": ["string", "null"]}, "balances_sha256": {"$ref": "#/$defs/sha256"}}},
    "cleanup": {"type": "object", "required": ["table_before", "table_after", "savepoint_restored", "stack_empty", "invocation_table_released"], "additionalProperties": false,
      "properties": {"table_before": {"type": "integer", "minimum": 0}, "table_after": {"type": "integer", "minimum": 0},
        "savepoint_restored": {"type": "boolean"}, "stack_empty": {"type": "boolean"},
        "invocation_table_released": {"type": ["boolean", "null"]}}},
    "observation": {"type": "object", "required": ["case_id", "sample_key", "outcome", "error_class", "trap", "value", "fuel", "receipts", "state", "rollback", "live_stores", "reservations", "resource_cleanup", "fresh_store", "suspended", "reused", "observed_depth"], "additionalProperties": false,
      "properties": {"case_id": {"type": "string"}, "sample_key": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["ok", "deterministic_error", "nondeterministic_error", "trap", "invocation_limit", "stack_overflow", "out_of_fuel"]},
        "error_class": {"enum": ["deterministic", "nondeterministic", null]},
        "trap": {"type": ["string", "null"]}, "value": {"type": ["string", "null"]},
        "fuel": {"$ref": "#/$defs/fuel"}, "receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
        "state": {"$ref": "#/$defs/state"}, "rollback": {"type": "boolean"},
        "live_stores": {"$ref": "#/$defs/counts"}, "reservations": {"$ref": "#/$defs/counts"},
        "resource_cleanup": {"$ref": "#/$defs/cleanup"},
        "fresh_store": {"type": "boolean"}, "suspended": {"type": "boolean"}, "reused": {"type": "boolean"},
        "observed_depth": {"type": ["integer", "null"], "minimum": 0}}},
    "worker_attempt": {"type": "object", "required": ["sample_key", "repeat_index", "phase_threads", "blocking_thread_ids", "cache_state"], "additionalProperties": false,
      "properties": {"sample_key": {"type": "string", "minLength": 1}, "repeat_index": {"type": "integer", "minimum": 0},
        "phase_threads": {"type": "object", "required": ["preparation", "operation", "conversion", "teardown"], "additionalProperties": false,
          "properties": {"preparation": {"$ref": "#/$defs/thread_ids"}, "operation": {"$ref": "#/$defs/thread_ids"},
            "conversion": {"$ref": "#/$defs/thread_ids"}, "teardown": {"$ref": "#/$defs/thread_ids"}}},
        "blocking_thread_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "cache_state": {"enum": ["cold", "warm", "mixed", "not_applicable"]}}},
    "thread_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "worker_execution": {"type": "object", "required": ["whole_operation_spawned", "source_sha256", "attempts"], "additionalProperties": false,
      "properties": {"whole_operation_spawned": {"const": true}, "source_sha256": {"$ref": "#/$defs/sha256"},
        "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_attempt"}}}},
    "case": {"type": "object", "required": ["id", "parameters", "observations", "raw_log", "worker_execution"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "parameters": {"type": "object"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "raw_log": {"$ref": "#/$defs/raw_log"}, "worker_execution": {"$ref": "#/$defs/worker_execution"}}},
    "configuration": {"type": "object", "required": ["process", "process_log", "engine", "runtime", "cases", "raw_logs", "source_artifact_sha256"], "additionalProperties": false,
      "properties": {"process": {"$ref": "#/$defs/process"}, "engine": {"$ref": "#/$defs/engine"},
        "process_log": {"$ref": "#/$defs/raw_log"},
        "runtime": {"$ref": "#/$defs/runtime"}, "cases": {"type": "array", "minItems": 41, "items": {"$ref": "#/$defs/case"}},
        "raw_logs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/raw_log"}},
        "source_artifact_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}}},
    "metric": {"type": "object", "required": ["value_bytes", "platform_field", "definition"], "additionalProperties": false,
      "properties": {"value_bytes": {"type": "integer", "minimum": 0}, "platform_field": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}}},
    "memory_snapshot": {"type": "object", "required": ["active_view_roots", "active_reactor_roots", "live_stores", "reservations", "fibers", "mapped_reservation", "resident", "committed_or_private", "node_accounted"], "additionalProperties": false,
      "properties": {"active_view_roots": {"type": "integer", "minimum": 0},
        "active_reactor_roots": {"type": "integer", "minimum": 0},
        "live_stores": {"type": "integer", "minimum": 0}, "reservations": {"type": "integer", "minimum": 0},
        "fibers": {"type": "integer", "minimum": 0}, "mapped_reservation": {"$ref": "#/$defs/metric"},
        "resident": {"$ref": "#/$defs/metric"}, "committed_or_private": {"$ref": "#/$defs/metric"},
        "node_accounted": {"$ref": "#/$defs/metric"}}},
    "memory_profile": {"type": "object", "required": ["id", "production_capacity_only", "uninstrumented", "reference_cpus", "reference_memory_bytes", "actual_cpus", "actual_memory_bytes", "enforced_cpus", "enforced_memory_bytes", "cpu_enforcement_field", "memory_enforcement_field", "guest_memory_occupancy_bytes", "cache_state", "per_root_allowance_bytes", "shared_overhead_allowance_bytes", "mapped_reservation_allowance_bytes", "per_node_allowance_bytes", "workload_plan_sha256", "view_roots", "reactor_roots", "baseline", "peak", "raw_os_log"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "production_capacity_only": {"const": true}, "uninstrumented": {"const": true},
        "reference_cpus": {"type": ["integer", "null"], "minimum": 1}, "reference_memory_bytes": {"type": ["integer", "null"], "minimum": 1},
        "actual_cpus": {"type": "integer", "minimum": 1}, "actual_memory_bytes": {"type": "integer", "minimum": 1},
        "enforced_cpus": {"type": ["integer", "null"], "minimum": 1},
        "enforced_memory_bytes": {"type": ["integer", "null"], "minimum": 1},
        "cpu_enforcement_field": {"type": "string", "minLength": 1},
        "memory_enforcement_field": {"type": "string", "minLength": 1},
        "guest_memory_occupancy_bytes": {"type": "integer", "minimum": 0}, "cache_state": {"type": "string"},
        "per_root_allowance_bytes": {"type": "integer", "minimum": 1}, "per_node_allowance_bytes": {"type": "integer", "minimum": 1},
        "shared_overhead_allowance_bytes": {"type": "integer", "minimum": 0},
        "mapped_reservation_allowance_bytes": {"type": "integer", "minimum": 1},
        "workload_plan_sha256": {"$ref": "#/$defs/sha256"},
        "view_roots": {"type": "integer", "minimum": 0}, "reactor_roots": {"type": "integer", "minimum": 0},
        "baseline": {"$ref": "#/$defs/memory_snapshot"}, "peak": {"$ref": "#/$defs/memory_snapshot"},
        "raw_os_log": {"$ref": "#/$defs/raw_log"}}}
  }
}
