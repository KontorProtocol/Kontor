{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulley boundary family process evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "qualification_status", "cell",
    "manifest_sha256", "source_sha", "binary_path", "binary_sha256",
    "timeout_seconds", "control_capture", "runs", "discovered_depths",
    "remaining_case_bindings", "development_discovery", "reviewed_discovery",
    "discovery_binary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"enum": ["pilot_discovery", "discovery", "pilot_replay", "final"]},
    "qualification_status": {"const": "missing"},
    "cell": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binary_path": {"type": "string", "minLength": 1},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
    "control_capture": {"$ref": "#/$defs/raw_log"},
    "development_discovery": {"oneOf": [
      {"type": "null"},
      {"$ref": "#/$defs/raw_log"}
    ]},
    "reviewed_discovery": {"oneOf": [
      {"type": "null"},
      {"$ref": "#/$defs/raw_log"}
    ]},
    "discovery_binary": {"oneOf": [
      {"type": "null"},
      {"$ref": "#/$defs/raw_log"}
    ]},
    "runs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/run"}
    },
    "discovered_depths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["last_success", "first_failure"],
        "properties": {
          "last_success": {"type": "integer", "minimum": 1},
          "first_failure": {"type": "integer", "minimum": 2}
        }
      }
    },
    "remaining_case_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "live_deposit_gas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "restored"],
      "properties": {
        "before": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0},
        "restored": {"type": "integer", "minimum": 0}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid", "command", "started_unix_ns", "ended_unix_ns",
        "exit_code", "signal", "timed_out", "complete", "test_harness_passed"
      ],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "started_unix_ns": {"type": "integer", "minimum": 1},
        "ended_unix_ns": {"type": "integer", "minimum": 1},
        "exit_code": {"type": "integer"},
        "signal": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "test_harness_passed": {"type": "boolean"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "process_role", "configuration", "probe_on", "pid",
        "sample_key", "repeat_index", "depth", "complete", "observation"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "process_role": {"type": "string"},
        "configuration": {"enum": ["reduced", "production"]},
        "probe_on": {"type": "boolean"},
        "pid": {"type": "integer", "minimum": 1},
        "sample_key": {"type": "string"},
        "repeat_index": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 0},
        "complete": {"const": true},
        "observation": {
          "type": "object",
          "required": ["live_deposit_gas", "live_deposit_gas_sha256"],
          "properties": {
            "live_deposit_gas": {"$ref": "#/$defs/live_deposit_gas"},
            "live_deposit_gas_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "case_id", "process_role", "configuration", "cell",
        "argv", "case_env", "process", "raw_log", "binary_sha256_before",
        "binary_sha256_after", "source_sha", "manifest_sha256",
        "timeout_seconds", "summary", "runtime", "thread_trace",
        "attempts", "timings"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "process_role": {"type": "string", "minLength": 1},
        "configuration": {"enum": ["reduced", "production"]},
        "cell": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "case_env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "process": {"$ref": "#/$defs/process"},
        "raw_log": {"$ref": "#/$defs/raw_log"},
        "binary_sha256_before": {"$ref": "#/$defs/sha256"},
        "binary_sha256_after": {"$ref": "#/$defs/sha256"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
        "summary": {"type": "object", "minProperties": 1},
        "runtime": {"type": "object", "minProperties": 1},
        "thread_trace": {"type": "object", "minProperties": 1},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "timings": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
