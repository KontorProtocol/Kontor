package test:call-results;

world root {
    include kontor:built-in/built-in;
    use kontor:built-in/context.{proc-context, view-context, contract};
    use kontor:built-in/error.{error};

    variant outcome {
        ok(string),
        err(string),
    }

    type reply = result<option<u64>, error>;
    type aliased-reply = reply;

    export init: func(ctx: borrow<proc-context>) -> contract;
    export maybe-value: func(ctx: borrow<view-context>) -> aliased-reply;
    export set-flag: func(ctx: borrow<proc-context>) -> result<_, error>;
    export check-flag: func(ctx: borrow<view-context>) -> result<_, error>;
    export outcome: func(ctx: borrow<view-context>) -> outcome;
    export wrapped-outcome: func(ctx: borrow<view-context>) -> result<outcome, error>;
    export echo-outcome: func(ctx: borrow<proc-context>, value: outcome) -> outcome;
}
