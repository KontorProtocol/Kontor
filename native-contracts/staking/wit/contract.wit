package root:component;

world root {
  include kontor:built-in/built-in;
  use kontor:built-in/context.{core-context, view-context, proc-context, contract};
  use kontor:built-in/error.{error};
  use kontor:built-in/numbers-types.{decimal};

  enum validator-status {
    inactive,
    active,
    pending-join,
    pending-exit,
  }

  record validator-info {
    x-only-pubkey: string,
    stake: decimal,
    status: validator-status,
    activation-height: u64,
    deactivation-height: u64,
    ed25519-pubkey: list<u8>,
  }

  record active-validator-info {
    x-only-pubkey: string,
    stake: decimal,
    ed25519-pubkey: list<u8>,
  }

  record staking-info {
    active-count: u64,
    total-stake: decimal,
  }

  record stake-info {
    stake: decimal,
    // None while bonded; a requested withdrawal still requires cleared obligations.
    withdrawal-height: option<u64>,
  }

  record validator-set-change {
    activated: u64,
    deactivated: u64,
  }

  export init: async func(ctx: borrow<proc-context>) -> contract;

  // --- Validator lifecycle (ProcContext — user-facing) ---
  export register-validator: async func(ctx: borrow<proc-context>, ed25519-pubkey: list<u8>, stake-amount: decimal) -> result<validator-info, error>;
  export leave-validation: async func(ctx: borrow<proc-context>) -> result<validator-info, error>;

  // Collateral can be bonded without registering a validator or supplying a consensus key.
  export add-stake: async func(ctx: borrow<proc-context>, amount: decimal) -> result<stake-info, error>;
  export begin-unstake: async func(ctx: borrow<proc-context>) -> result<stake-info, error>;
  export withdraw-stake: async func(ctx: borrow<proc-context>) -> result<stake-info, error>;
  export get-stake: async func(ctx: borrow<view-context>, holder: string) -> option<stake-info>;

  // --- System initialization (CoreContext — called during native contract publishing) ---
  export set-genesis-set: async func(ctx: borrow<core-context>, validators: list<active-validator-info>);

  // --- Per-block validator processing (CoreContext — called by block handler) ---
  export process-pending-validators: async func(ctx: borrow<core-context>, block-height: u64) -> result<validator-set-change, error>;

  export distribute-ordering-reward: async func(ctx: borrow<core-context>, amount: decimal) -> result<decimal, error>;
  export has-reward-recipients: async func(ctx: borrow<view-context>) -> bool;
  export last-reward-height: async func(ctx: borrow<view-context>) -> option<u64>;

  // --- Queries (ViewContext) ---
  export get-active-set: async func(ctx: borrow<view-context>) -> list<active-validator-info>;
  export get-validator: async func(ctx: borrow<view-context>, x-only-pubkey: string) -> option<validator-info>;
  export get-staking-info: async func(ctx: borrow<view-context>) -> staking-info;
  export get-active-count: async func(ctx: borrow<view-context>) -> u64;
}
