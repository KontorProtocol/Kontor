 use crate::test_utils::test_runtime;

 const BUDGET: u64 = 100_000_000;
+
+#[tokio::test]
+async fn abi_string_failures_have_typed_classification() -> Result<()> {
+    let (runtime, _dir, _name) = test_runtime().await?;
+    for fixture in [
+        include_str!("fixtures/abi-string-return.wat"),
+        include_str!("fixtures/abi-async-string-return.wat"),
+    ] {
+        for (encoding, ptr, len, allowance, expected) in [
+            ("", 0, 8, 8, "valid"),
+            ("", 0, 8, 7, "allowance"),
+            ("", 8, 1, 8, "encoding"),
+            ("", 65535, 8, 8, "bounds"),
+            (" string-encoding=utf16", 16, 1, 8, "encoding"),
+            (" string-encoding=utf16", 1, 1, 8, "alignment"),
+        ] {
+            let wat = fixture.replace("(memory $", &format!("{encoding} (memory $"));
+            let component = Component::new(&runtime.engine, wat)?;
+            let mut store = runtime.make_store(BUDGET)?;
+            store.set_hostcall_fuel(allowance);
+            let instance = Linker::new(&runtime.engine)
+                .instantiate_async(&mut store, &component)
+                .await?;
+            let func = instance.get_func(&mut store, "run").unwrap();
+            let mut results = [Val::Bool(false)];
+            let result = func
+                .call_async(&mut store, &[Val::U32(ptr), Val::U32(len)], &mut results)
+                .await;
+            if expected == "valid" {
+                result?;
+                assert_eq!(results[0], Val::String("abcdefgh".into()));
+                continue;
+            }
+            let error = result.unwrap_err();
+            assert!(
+                match expected {
+                    "allowance" => error.is::<HostcallFuelExhausted>(),
+                    "encoding" => error.is::<InvalidStringEncoding>(),
+                    "bounds" => error.downcast_ref::<Trap>() == Some(&Trap::StringOutOfBounds),
+                    "alignment" => error.downcast_ref::<Trap>() == Some(&Trap::UnalignedPointer),
+                    _ => unreachable!(),
+                },
+                "{expected}: {error:?}"
+            );
+            let classified =
+                Runtime::decode_result(false, Ok(Err(error)), results.to_vec(), &mut store).await;
+            assert!(matches!(classified, Err(ExecutionError::Deterministic(_))));
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn abi_error_classification_preserves_infrastructure_failures() -> Result<()> {
+    let (runtime, _dir, _name) = test_runtime().await?;
+    for error in [
+        WasmtimeError::from(OutOfMemory::new(1024)),
+        WasmtimeError::msg("unknown engine failure"),
+        WasmtimeError::from_anyhow(anyhow!("database unavailable")),
+        WasmtimeError::from_anyhow(ExecutionError::NonDeterministic(Trap::OutOfFuel.into()).into()),
+        WasmtimeError::from_anyhow(
+            ExecutionError::NonDeterministic(HostcallFuelExhausted.into()).into(),
+        ),
+    ] {
+        let mut store = runtime.make_store(BUDGET)?;
+        let result = Runtime::decode_result(
+            false,
+            Ok(Err(error.context("call failed"))),
+            vec![],
+            &mut store,
+        )
+        .await;
+        assert!(
+            matches!(result, Err(ExecutionError::NonDeterministic(_))),
+            "{result:?}"
+        );
+    }
+    Ok(())
+}

